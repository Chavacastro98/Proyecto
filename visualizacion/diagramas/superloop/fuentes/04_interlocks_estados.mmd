stateDiagram-v2
    [*] --> Standby: Sistema Inicializado (Todo Seguro)

    state Standby {
        [*] --> Listo: DAC=0V, Rele 2CH=Aislado (HIGH), TRIACs=0%
    }

    state Proceso {
        state "Control Termico (4x PI @ 1 Hz)" as Termico
        state "Fuente Galvanica VCSS (ZCS Activo)" as Fuente
        state "Monitoreo Ambiental (AHT20/BMP280 @ 0.2 Hz)" as Ambiental
        Termico --> Termico: PI 1000ms + Rampa 200ms
        Fuente --> Fuente: Lazo Cerrado / Modulacion PWM
    }

    state ModuloPH {
        state "Muestreo TDM ADS1115 (A0/A1 @ 25 Hz)" as MuestreoPH
        state "Filtro Mediana 3 + EWMA Suavizador" as FiltroPH
    }

    state ModoOTA {
        state "Corte Inmediato de Actuadores (Fail-Safe)" as ApagadoTotal
        state "Escritura en Particion Flash A/B" as FlashUpdate
    }

    Standby --> Proceso: Encender Termico o Fuente (Rele 2CH Energizado)
    Proceso --> Standby: Apagar Termico y Fuente (Rele 2CH Aislado ZCS)

    Standby --> ModuloPH: Encender pH (Termico=OFF, Fuente=OFF, Rele=Aislado)
    ModuloPH --> Standby: Apagar pH

    Proceso --> ModuloPH: Intentar Encender pH -> BLOQUEADO (HTTP 409 Conflict)
    ModuloPH --> Proceso: Intentar Encender Proceso -> Apaga pH Automaticamente

    Standby --> ModoOTA: Subir firmware .bin (Todo en OFF)
    Proceso --> ModoOTA: Subir firmware .bin (Apagado de Emergencia Inmediato)
    ModoOTA --> Standby: Reinicio ESP32 (Firmware Validado)
