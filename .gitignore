# =================================================================================
# .gitignore - Sistema Automatizado de Electrodeposición y Galvanoplastia
# =================================================================================

# Archivos Comprimidos y Respaldos Manuales
*.zip
*.rar
*.7z
*.tar.gz
*.bak
*.txt.bak

# Compilación y Artefactos de Microcontroladores (ESP32-S3 / Arduino)
build/
firmware/**/build/
*.bin
*.elf
*.hex
*.eep
*.lss
*.sym
*.map
*.d

# Python: Bytecode, Cachés y Entornos Virtuales
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/
.coverage
htmlcov/

# Distribución y Empaquetado (PyInstaller, setuptools)
dist/
*.egg-info/
*.egg
.eggs/

# IDEs, Editores y Sistema Operativo
.vscode/
.idea/
*.swp
*.swo
*~
Thumbs.db
Desktop.ini
.DS_Store

# Archivos Temporales de Logs y Telemetría de Ensayo
*.log
*.tmp
*.csv.tmp
herramientas/telemetria/experimentos/
software/telemetria/experimentos/

# Documentos Académicos Confidenciales (Tesis, protocolos, reportes de titulación)
documentos/academicos/

# Scripts de Prueba y Borradores de Desarrollo (Scratchpad)
herramientas/scratch/

# Carpetas de Vista Previa Redundantes (la oficial vive en visualizacion/preview/)
/preview/

# Accesos directos locales de Windows
*.url

# Optimización de Repositorio (Archivos Pesados y Duplicados conservados localmente en PC)
documentos/datasheets/*.pdf
documentos/manuales/*.pdf
documentos/imagenes/
visualizacion/diagramas/imagenes/
visualizacion/diagramas/superloop/
visualizacion/preview/Beta/
visualizacion/preview/Original/
visualizacion/preview/2.0/
visualizacion/preview/3.0/
visualizacion/preview/3.5/
visualizacion/preview/4.0/
visualizacion/preview/RTOS1.0/
visualizacion/preview/RTOS1.1/
visualizacion/preview/RTOS1.2/
visualizacion/preview/RTOS1.3/
firmware/**/historico/
software/telemetria/
